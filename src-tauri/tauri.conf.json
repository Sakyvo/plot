{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plot",
  "version": "1.0.0",
  "identifier": "dev.plot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Plot",
        "width": 920,
        "height": 640,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#16181d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
